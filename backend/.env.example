# Copy this file to .env and fill in your values.
#
# LOCAL DEVELOPMENT:
#   DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/railpredict_db
#
# RAILWAY DEPLOYMENT:
#   Railway auto-injects DATABASE_URL as a full postgres:// URI.
#   Set it in your Railway service environment variables.
#   Example: postgresql+psycopg2://postgres:pass@containers-us-west-XXX.railway.app:5432/railway
#
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/railpredict_db
DEBUG=false
